#!/usr/bin/env bash
# Claude Code WorktreeRemove hook: removes a worktree made by worktree-create, and its branch unless the branch has
# commits that are not merged.
set -euo pipefail

path=$(jq -r .worktree_path)
[ -d "$path" ] || exit 0
root=$(dirname "$(git -C "$path" rev-parse --path-format=absolute --git-common-dir)")
branch=$(git -C "$path" branch --show-current)

git -C "$root" worktree remove --force "$path" >&2
git -C "$root" branch -d "$branch" >&2 || true
