#!/usr/bin/env bash
# Prints the URL bin/dev serves this checkout at: https://sample.localhost for the main checkout,
# https://<folder>.sample.localhost for a linked worktree.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ -f .git ]; then
  # A hostname label has at most 63 characters and doesn't start or end with a hyphen.
  label=$(basename "$PWD" | tr A-Z a-z | sed -E 's/[^a-z0-9]+/-/g' | cut -c1-63 | sed -E 's/^-+|-+$//g')
  echo "https://$label.sample.localhost"
else
  echo "https://sample.localhost"
fi
